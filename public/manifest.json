{
  "manifest_version": 3,
  "name": "DeepSeek Chat Archiver",
  "description": "批量归档 DeepSeek 网页端全部对话：正文、思考过程、联网引用、附件与分支，输出 Markdown / Word / 纯文本 / JSON。",
  "version": "0.1.0",
  "minimum_chrome_version": "110",
  "permissions": ["downloads"],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://files.deepseeksvc.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pageHook.js"],
      "matches": ["https://chat.deepseek.com/*"]
    }
  ],
  "action": {
    "default_title": "DeepSeek Chat Archiver"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}